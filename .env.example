# Copy this file to .env and fill in the values
# .env is gitignored — never commit real credentials

# Neon PostgreSQL connection string
# Find this in your Neon dashboard → Connection Details → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Shared secret for POST /api/revalidate — the dashboard sends it as the
# x-revalidate-secret header after editing links. Generate with:
#   openssl rand -hex 32
WDCC_INTERNAL_KEY=
